# CareerPath environment variables. Copy to .env.local and fill in what you have.
# Everything is optional: without these, the app runs fully on its local fallback.

# Supabase (auth + database). When both are set, sign-in and data use Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Path Assistant. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
