# CareerPath environment variables. Copy to .env.local and fill in what you have.
# Everything is optional: without these, the app runs fully on its local fallback.

# Supabase (auth + database). When both are set, sign-in and data use Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Path Assistant. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Free alternative for the AI advisor (used when ANTHROPIC_API_KEY is not set).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default tries gemini-flash-latest, then gemini-2.5-flash)
GEMINI_MODEL=
